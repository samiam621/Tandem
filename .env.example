# Copy to apps/server/.env and fill in values

# Postgres or SQLite (SQLite for local dev)
DATABASE_URL=file:./tandem.db

# OpenRouter — stays on the server, never sent to clients
OPENROUTER_API_KEY=
# Only :free models are listed and called unless this is true
OPENROUTER_ALLOW_PAID=false

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Token HMAC secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_SECRET=

# Public base URL (for OAuth callbacks and invite links)
PUBLIC_URL=http://localhost:3000

# HTTP port
PORT=3000
